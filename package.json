  "author": "Garbo Succus <hello@garbo.succus.games> (https://garbo.succus.games)",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/generate.mjs all",
    "build": "tsc && node scripts/build-catalog.mjs && node scripts/build-catalog.mjs --cc0 && node scripts/build-catalog.mjs --game-pieces && node scripts/build-showcase.mjs",
    "dev": "pnpm build && storybook dev -p 6006",
    "build-storybook": "pnpm build && storybook build",
    "dev:dice": "vite --host 127.0.0.1 --port 6102",
    "generate:dominoes": "node scripts/generate.mjs dominoes",
    "generate:poker-chips": "node scripts/generate.mjs poker-chips",
    "generate:checkers": "node scripts/generate.mjs checkers",
    "generate:shapes": "node scripts/generate.mjs shapes",
    "generate:dice": "node scripts/generate.mjs dice",
    "generate": "node scripts/generate.mjs",
    "optimize": "node scripts/optimize.mjs",
    "audit:textures": "node scripts/audit-textures.mjs",
    "test": "node --test scripts/test-*.mjs",
    "studio": "vite --host 127.0.0.1 --port 6102"
  },
  "homepage": "https://probability-nz.github.io/tokens",
  "repository": "https://github.com/probability-nz/tokens",
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@storybook/react-vite": "^10.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "fflate": "0.8.2",
    "meshoptimizer": "1.1.1",
    "playwright-core": "1.65.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
